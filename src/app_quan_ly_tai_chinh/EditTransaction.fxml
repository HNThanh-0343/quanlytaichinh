<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" style="-fx-padding: 20px; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 2px; -fx-border-radius: 10px;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app_quan_ly_tai_chinh.EditTransactionController">

    <!-- Title -->
    <Label text="Edit Transaction" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- Description -->
    <VBox spacing="5">
        <Label text="Description:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="descriptionField" promptText="Enter description" style="-fx-pref-width: 300px;"/>
    </VBox>

    <!-- Amount -->
    <VBox spacing="5">
        <Label text="Amount:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="amountField" promptText="Enter amount" style="-fx-pref-width: 300px;"/>
    </VBox>

    <!-- Date -->
    <VBox spacing="5">
        <Label text="Date:" style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="datePicker" style="-fx-pref-width: 300px;"/>
    </VBox>

    <!-- Transaction Type (Income / Expense) -->
    <VBox spacing="5">
        <Label text="Transaction Type:" style="-fx-font-weight: bold;"/>
        <HBox spacing="15" alignment="CENTER">
            <RadioButton fx:id="incomeRadio" text="Income"/>
            <RadioButton fx:id="expenseRadio" text="Expense"/>
        </HBox>
    </VBox>

    <!-- Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="confirmButton" text="Confirm" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button fx:id="cancelButton" text="Cancel" style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>
